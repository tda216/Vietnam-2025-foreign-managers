# Layout: one folder per country (vietnam/, thailand/, philippines/, malaysia/, indonesia/) + shared/ code.
# Patterns with "*/" apply to every country. Comments must be on their own line: a trailing "# …" breaks the pattern.

# Kept locally, not pushed (too large or binary):
# downloaded source PDFs/HTML (VN ~88 GB, TH ~20 GB, PH ~3.5 GB) - evidence behind the Page column; UNTRUSTED input
raw/
# per-page text and OCR extracted from the PDFs (VN ~870 MB)
/*/data/full/text/
/*/data/full/ocr/
/*/data/full/logs/
# Indonesia: page text/OCR caches of the annual reports and BAE register reports (regenerated by id05_text.py / id05b_reg_text.py)
indonesia/data/text/
indonesia/data/reg_text/

# shared tooling at the repo root
.venv/
# tesseract/bsdtar unpacked without root
.tools/
__pycache__/
*.pyc
.~lock.*#
~$*
.DS_Store

# licensed inputs (Bloomberg, BoardEx) sit in the country folder itself
/*/*.xlsx
Bloomberg-*.xlsx
# Malaysia: local login for malaysiastock.biz (never commit)
malaysia/.malaysiastock_login

# Bloomberg-derived data (licensed values: market cap, industry, price, Bloomberg tickers / short names)
# stays local - owner decision 10 Nov 2026 (the repository is public)
*/data/universe.csv
vietnam/data/companies_step2.csv
vietnam/data/full/qa_sample_companies.csv
thailand/data/companies_step2.csv
thailand/data/qa_sample_companies.csv
thailand/data/country_context.csv
indonesia/data/pilot30.csv
indonesia/data/manual_ar_list.csv
indonesia/data/fo_ksei_*.csv
# workbooks carry Bloomberg fields (Companies: Market_Cap, Industry_Group; VN: Bloomberg_Raw sheet; TH: also BoardEx)
*/output/*.xlsx
# Thailand: derived copies of the licensed BoardEx input
thailand/data/boardex_people.csv
thailand/data/boardex_roles.csv
